<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0: runs on Windows and macOS. Control-level tests use the Avalonia headless platform. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lemon.Template.Avalonia\Lemon.Template.Avalonia.csproj" />
  </ItemGroup>

  <!--#if (EnableHangfire) -->
  <ItemGroup>
    <!--
      The shared framework the app itself runs on. Without it NuGet cannot prune the packages that framework
      already supplies, and resolves the old System.Security.Cryptography.Xml package pulled in by
      Volo.Abp.HangFire (NU1903) instead of the framework's serviced copy.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!--#endif -->

</Project>
