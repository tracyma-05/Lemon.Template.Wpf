<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version / Authors / Description arrive via Directory.Build.props -> common.props. -->
  <!--
    NuGet template pack: installs as `dotnet new install <PackageId>` and brings two templates:
      lemon-wpf       content/Lemon.Template.Wpf        (Windows, WPF)
      lemon-avalonia  content/Lemon.Template.Avalonia   (Windows / macOS, Avalonia)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Include .templateignore (dot-prefixed) in the nupkg -->
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <PackageType>Template</PackageType>
    <PackageId>Lemon.Templates.Wpf</PackageId>
    <!-- Keep in sync with main app: common.props → Version -->
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>$(Authors)</Authors>
    <Description>$(Description)</Description>
    <PackageTags>dotnet-new;template;WPF;Avalonia;CrossPlatform;MaterialDesign;Hangfire</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet.org only allows PackageIcon as .png / .jpg (not .ico). Use the same artwork as the app. -->
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="src\Lemon.Template.Wpf\Assets\Images\logo.png" Pack="true" PackagePath="logo.png" />
  </ItemGroup>

  <!--
    Repository-level files every scaffold needs. Listed once and packed into each template's content folder
    below, so the two templates cannot drift apart.
  -->
  <ItemGroup>
    <SharedTemplateFile Include=".templateignore;.editorconfig;common.props;LICENSE.txt;README.md;CONTRIBUTING.md;CHANGELOG.md" />
    <!-- The scaffolded app relies on both: PackageReference entries carry no Version of their own. -->
    <SharedTemplateFile Include="Directory.Build.props;Directory.Packages.props" />
  </ItemGroup>

  <!--
    PackagePath uses forward slashes on purpose. CI packs on Linux, where NuGet does not treat a backslash as
    a separator: "content\Lemon.Template.Wpf\" became "content/Lemon.Template.Wpf//.editorconfig", the
    template engine read "/.editorconfig" as an absolute path, and the shared files were written to the
    drive root instead of the scaffold folder. The pack job in ci.yml fails on any such entry.
  -->
  <!-- lemon-wpf -->
  <ItemGroup>
    <Content Include=".template.config\**\*" PackagePath="content/Lemon.Template.Wpf/.template.config/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="@(SharedTemplateFile)" PackagePath="content/Lemon.Template.Wpf/" />
    <!-- Consumer-facing sln only (avoids tools/template-pack/.template.config nodes from the dev solution). -->
    <Content Include="packaging\Lemon.Template.Wpf.sln" PackagePath="content/Lemon.Template.Wpf/Lemon.Template.Wpf.sln" />
    <Content Include="src\Lemon.Template.Wpf\**\*" Exclude="src\**\bin\**;src\**\obj\**" PackagePath="content/Lemon.Template.Wpf/src/Lemon.Template.Wpf/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Shipped unless the consumer sets the IncludeTests option to false, which excludes tests/ at instantiation. -->
    <Content Include="tests\Lemon.Template.Wpf.Tests\**\*" Exclude="tests\**\bin\**;tests\**\obj\**" PackagePath="content/Lemon.Template.Wpf/tests/Lemon.Template.Wpf.Tests/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    lemon-avalonia. Laid out exactly like the repository: its template.json lives in templates/avalonia and
    reads everything through "source": "../../", so the same manifest works for `dotnet new install .` from a
    clone and for the installed package.
  -->
  <ItemGroup>
    <Content Include="templates\avalonia\.template.config\**\*" PackagePath="content/Lemon.Template.Avalonia/templates/avalonia/.template.config/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="@(SharedTemplateFile)" PackagePath="content/Lemon.Template.Avalonia/" />
    <Content Include="packaging\Lemon.Template.Avalonia.sln" PackagePath="content/Lemon.Template.Avalonia/packaging/" />
    <Content Include="src\Lemon.Template.Avalonia\**\*" Exclude="src\**\bin\**;src\**\obj\**" PackagePath="content/Lemon.Template.Avalonia/src/Lemon.Template.Avalonia/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="tests\Lemon.Template.Avalonia.Tests\**\*" Exclude="tests\**\bin\**;tests\**\obj\**" PackagePath="content/Lemon.Template.Avalonia/tests/Lemon.Template.Avalonia.Tests/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
