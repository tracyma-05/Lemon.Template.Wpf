<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Repository-scoped feed list. Every package in Directory.Packages.props resolves from nuget.org, so
    <clear /> drops any machine- or user-level source that would otherwise be inherited. That keeps restore
    reproducible and silences NU1507 (central package management wants a single source).

    This file is deliberately excluded from the `dotnet new` template output (.templateignore and
    template.json -> sources.exclude): scaffolded projects must inherit whatever feed their environment
    configures, which is often an internal mirror rather than nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
