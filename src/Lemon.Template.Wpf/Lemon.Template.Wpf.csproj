<Project Sdk="Microsoft.NET.Sdk">

    <!-- Shared properties come from Directory.Build.props; package versions from Directory.Packages.props. -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Assets\Images\logo.ico</ApplicationIcon>
    </PropertyGroup>

    <!--
        Feature switches. Each constant matches a `dotnet new` template symbol, so the enabled set here
        always mirrors the features this project actually contains.
    -->
    <PropertyGroup>
        <!--#if (EnableHangfire) -->
        <DefineConstants>$(DefineConstants);EnableHangfire</DefineConstants>
        <!--#endif -->
        <!--#if (EnableTrayIcon) -->
        <DefineConstants>$(DefineConstants);EnableTrayIcon</DefineConstants>
        <!--#endif -->
        <!--#if (EnableDesktopShortcut) -->
        <DefineConstants>$(DefineConstants);EnableDesktopShortcut</DefineConstants>
        <!--#endif -->
    </PropertyGroup>

    <!--#if (EnableHangfire) -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <!--#endif -->

    <ItemGroup>
        <InternalsVisibleTo Include="Lemon.Template.Wpf.Tests" />
    </ItemGroup>

	
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="MaterialDesignColors" />
        <PackageReference Include="MaterialDesignThemes" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
        <PackageReference Include="Volo.Abp.Autofac" />
        <!--#if (EnableTrayIcon) -->
        <PackageReference Include="H.NotifyIcon.Wpf" />
        <!--#endif -->
        <!--#if (EnableHangfire) -->
        <PackageReference Include="Hangfire.AspNetCore" />
        <PackageReference Include="Hangfire.Storage.SQLite" />
        <PackageReference Include="Microsoft.Web.WebView2" />
        <PackageReference Include="Volo.Abp.BackgroundJobs.HangFire" />
        <!--#endif -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Async" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="appsettings.json" />
      <None Remove="Assets\logo.ico" />
      <None Remove="Assets\logo.png" />
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Resource Include="Assets\Images\logo.ico" />
      <Resource Include="Assets\Images\logo.png" />
    </ItemGroup>

</Project>