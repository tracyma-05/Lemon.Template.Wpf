<Window x:Class="Lemon.Template.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lemon.Template.Wpf.Views"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:nav="clr-namespace:Lemon.Template.Wpf.Infrastructures.Navigations"
        xmlns:converters="clr-namespace:Lemon.Template.Wpf.Converters"
        xmlns:model="clr-namespace:Lemon.Template.Wpf.Models"
        xmlns:constants="clr-namespace:Lemon.Template.Wpf.Commons"
        xmlns:controls="clr-namespace:Lemon.Template.Wpf.Themes.Controls"
        xmlns:loc="clr-namespace:Lemon.Template.Wpf.Infrastructures.Localization"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        FontSize="14"
        MinWidth="1080"
        MinHeight="768">
    <materialDesign:DialogHost DialogTheme="Inherit" Identifier="Root">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" x:Name="GridLeftMenu"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Margin="0,-3" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignShadowBrush}">
                <Grid RowDefinitions="auto,*">
                    <DockPanel Margin="12,15" VerticalAlignment="Center" LastChildFill="True">
                        <ToggleButton x:Name="toggleMenuButton"
                                      DockPanel.Dock="Right"
                                      Content="{materialDesign:PackIcon Kind=MenuOpen}"
                                      VerticalAlignment="Center"
                                      materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=ArrowRight}"
                                      Style="{StaticResource MaterialDesignActionToggleButton}"
                                      ToolTip="{loc:Localize Shell_MenuToggle_ToolTip}" />
                        <Grid x:Name="StackHeader" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Source="/Assets/Images/logo.ico" />
                            <TextBlock Grid.Column="1"
                                       Text="Lemon.Template.Wpf"
                                       Margin="5,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </Grid>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="10" ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl>
                                        <Expander Padding="0"
                                                  materialDesign:ExpanderAssist.HorizontalHeaderPadding="0 10"
                                                  Style="{DynamicResource MaterialDesignExpander}"
                                                  Background="Transparent"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="{Binding Icon}" ToolTip="{Binding DisplayTitle}" />
                                                    <TextBlock Style="{StaticResource NavigationCollapsibleTextStyle}"
                                                               Text="{Binding DisplayTitle}"
                                                               FontSize="16" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <Expander.Content>
                                                <!--
                                                    The transform is declared here rather than in NavigationGroupItemsStyle
                                                    so each group owns an unfrozen instance the reveal storyboard can animate.
                                                -->
                                                <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource NavigationGroupItemsStyle}">
                                                    <ItemsControl.RenderTransform>
                                                        <TranslateTransform Y="-8" />
                                                    </ItemsControl.RenderTransform>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <RadioButton Style="{StaticResource NavigationChildMenuItemStyle}"
                                                                         GroupName="Menu"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander.Content>
                                        </Expander>
                                        <ContentControl.Style>
                                            <!-- No children: render the entry itself instead of an empty expander. -->
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                        <Setter Property="Template" Value="{StaticResource NavigationChildlessItemTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Items}" Value="{x:Null}">
                                                        <Setter Property="Template" Value="{StaticResource NavigationChildlessItemTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="{DynamicResource MaterialDesignPaper}"/>
                <StackPanel Margin="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">

                    <ToggleButton IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  IsThreeState="False"
                                  Margin="5"
                                  Padding="5"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  ToolTip="{loc:Localize Shell_ThemeToggle_ToolTip}">
                        <Grid Width="20" Height="20">
                            <materialDesign:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="WeatherNight">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <materialDesign:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="WhiteBalanceSunny">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </ToggleButton>

                    <Button x:Name="BtnMin"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Localize Shell_Minimize_ToolTip}"
                        Style="{DynamicResource IconButtonStyle}">
                        <materialDesign:PackIcon Kind="WindowMinimize"/>
                    </Button>
                    <Button x:Name="BtnMax"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Localize Shell_Maximize_ToolTip}"
                        Style="{DynamicResource IconButtonStyle}" >
                        <materialDesign:PackIcon Kind="Maximize"/>
                    </Button>
                    <Button x:Name="BtnClose"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Localize Shell_Close_ToolTip}"
                        Style="{DynamicResource IconButtonStyle}" >
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>
                </StackPanel>

                <!--  选项卡  -->
                <!--<controls:TabControl Grid.Row="1"
                    HorizontalContentAlignment="Left"
                    controls:TabCloseItem.CloseClick="OnCloseButtonClick"     
                    materialDesign:ElevationAssist.Elevation="Dp1"
                    nav:RegionManagerAttached.RegionName="{x:Static constants:Constants.MainRegion}"
                    SelectedIndex="{Binding SelectedIndex}"
                    Foreground="{DynamicResource MaterialDesignShadowBrush}"
                    Style="{StaticResource DefaultMaterialDesignTabControl}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=controls:TabCloseItem}}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </controls:TabControl>-->

                <ScrollViewer Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ContentControl nav:RegionManagerAttached.RegionName="{x:Static constants:Constants.MainRegion}" />
                </ScrollViewer>

            </Grid>


        </Grid>
    </materialDesign:DialogHost>
</Window>